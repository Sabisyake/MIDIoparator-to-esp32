#include <NimBLEDevice.h>

#define SERVICE_UUID           "6e400001-b5a3-f393-e0a9-e50e24dcca9e"
#define CHARACTERISTIC_UUID_RX "6e400002-b5a3-f393-e0a9-e50e24dcca9e"
#define CHARACTERISTIC_UUID_TX "6e400003-b5a3-f393-e0a9-e50e24dcca9e"

//モーター設定
enum MOTOR_ID{
  MOTOR_FL,MOTOR_ML,MOTOR_BL,
  MOTOR_FR,MOTOR_MR,MOTOR_BR
};

constexpr uint8_t pins[]={
  14,27,
  26,25,
  33,32,
  16,17,
  5,18,
  19,21
};

NimBLECharacteristic *txCharacteristic;

volatile bool deviceConnected=false;
volatile int targetSpeed[6]={0,0,0,0,0,0};
int currentSpeed[6]={999,999,999,999,999,999};

void rotate(uint8_t ID,int speed){
  speed=constrain(speed,-255,255);
  ledcWrite(pins[ID*2],   speed>0 ? speed : 0);
  ledcWrite(pins[ID*2+1], speed<0 ? -speed : 0);
}

class ServerCallbacks : public NimBLEServerCallbacks {
  void onConnect(NimBLEServer* server){
    deviceConnected=true;
  }
  void onDisconnect(NimBLEServer* server){
    deviceConnected=false;
    for(int i=0;i<6;i++){
      targetSpeed[i]=0;
    }
    NimBLEDevice::startAdvertising();
  }
};

// MIDI変換
int angleToSpeed(int angle){
  if(angle > 100) return 200;
  if(angle > 90 ) return 100;
  if(angle < 80 ) return -100;
  if(angle <=80 ) return -200;
  return 0;
}

// BLE受信
class RxCallbacks : public NimBLECharacteristicCallbacks {
  void onWrite(NimBLECharacteristic* characteristic){
    std::string value=characteristic->getValue();

    if(value.length()<3) return;
    uint8_t status=(uint8_t)value[0];
    uint8_t data1 =(uint8_t)value[1];
    uint8_t data2 =(uint8_t)value[2];
    // 左スティック
    if(status==177 && data1==0){
      int angle=map(data2,0,127,0,180);
      int spd=angleToSpeed(angle);
      targetSpeed[MOTOR_FL]=spd;
      targetSpeed[MOTOR_ML]=spd;
      targetSpeed[MOTOR_BL]=spd;
    }
    // 右スティック
    else if(status==176 && data1==0){
      int angle=map(data2,0,127,0,180);
      int spd=angleToSpeed(angle);
      targetSpeed[MOTOR_FR]=spd;
      targetSpeed[MOTOR_MR]=spd;
      targetSpeed[MOTOR_BR]=spd;
    }
    // L1
    else if(status==176 && data1==34){
      targetSpeed[MOTOR_FL]=-100;
      targetSpeed[MOTOR_BL]= 100;
    }
    // R1
    else if(status==177 && data1==34){
      targetSpeed[MOTOR_FR]=-100;
      targetSpeed[MOTOR_BR]= 100;
    }

    // 緊急停止
    else if(status==148 && data1==71){
      for(int i=0;i<6;i++){
        targetSpeed[i]=0;
      }
    }
  }
};

void setup(){
  Serial.begin(115200);
  // PWM初期化
  for(uint8_t pin:pins){
    ledcAttach(pin,12800,8);
    ledcWrite(pin,0);
  }
  // BLE
  NimBLEDevice::init("ESP32-UART");
  NimBLEDevice::setMTU(247);
  NimBLEServer* server= NimBLEDevice::createServer();
  server->setCallbacks(new ServerCallbacks());
  NimBLEService* service=server->createService(SERVICE_UUID);
  txCharacteristic=service->createCharacteristic(CHARACTERISTIC_UUID_TX,NIMBLE_PROPERTY::NOTIFY);
  NimBLECharacteristic* rxCharacteristic =
    service->createCharacteristic(
        CHARACTERISTIC_UUID_RX,
        NIMBLE_PROPERTY::WRITE_NR
  );
  rxCharacteristic->setCallbacks(new RxCallbacks());
  service->start();

  NimBLEAdvertising* advertising=NimBLEDevice::getAdvertising();
  advertising->addServiceUUID(SERVICE_UUID);

  advertising->setMinInterval(6);
  advertising->setMaxInterval(12);

  advertising->start();

  Serial.println("Advertising Start");
}

void loop(){
  for(int i=0;i<6;i++){
    int spd=targetSpeed[i];
    if(spd!=currentSpeed[i]){
      currentSpeed[i]=spd;
      rotate(i,spd);
    }
  }
  delay(1);
}
